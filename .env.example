DATABASE_URL=postgresql://user:password@localhost:5432/contentflow?sslmode=disable
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=your_super_secret_auth_token_min_32_chars
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email (Resend)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM="ContentFlow <newsletter@yourdomain.com>"

# Storage (local / cloudinary / s3)
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# AWS S3 (if STORAGE_PROVIDER=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=

# Optional Redis for rate limiting & cache
REDIS_URL=redis://localhost:6379

# Cron Secret for automated scheduled publishing endpoint
CRON_SECRET=your_cron_secret_key_here
